# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nagoweb

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── File Storage ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100

# ─── Admin ────────────────────────────────────────────────
# Email address that receives new payment proof alerts
ADMIN_EMAIL=admin@example.com

# ─── Client ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email / SMTP ─────────────────────────────────────────
# Leave EMAIL_HOST blank to run in preview mode (logs to console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=negaromanzir@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=NagoWeb
EMAIL_FROM_ADDR=noreply@nagoweb.com

# ─── Download Tokens ──────────────────────────────────────
DOWNLOAD_TOKEN_TTL_HOURS=24
DOWNLOAD_TOKEN_MAX_USES=3
